# Copy this file to .env and fill in real values before running docker compose.
# Never commit the real .env — it holds production secrets.

# --- Database ---
DB_USER=vpms
DB_PASSWORD=
DB_NAME=vpms

# --- Auth ---
# Generate with: openssl rand -base64 48   (or: python3 -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=

# --- App ---
# Port the app is reachable on from outside the VM (must be open in Bharat Cloud's firewall/security group).
# Use 8020 in the production checkout, 8010 in the staging checkout.
APP_PORT=8020
